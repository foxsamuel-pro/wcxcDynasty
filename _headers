# Read by Cloudflare Pages and by Netlify, so the site keeps these headers
# whichever one is serving it. Indentation matters: two spaces under the path.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # Everything this page is allowed to talk to. Anything not listed here gets
  # blocked by the browser, silently, with only a console error to show for it.
  #   cdn.jsdelivr.net      supabase-js
  #   fonts.googleapis.com  the Roboto stylesheet
  #   fonts.gstatic.com     the font files themselves
  #   sleepercdn.com        team and league avatars
  #   api.sleeper.app       records and the current week
  #   *.supabase.co         ballots over https, live updates over wss
  # Adding a CDN, analytics script, or a second Supabase project means adding it here.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://sleepercdn.com; connect-src 'self' https://api.sleeper.app https://*.supabase.co wss://*.supabase.co; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Never serve a stale shell — a new tab or fix should show up on refresh.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

