// The live site: a Cloudflare Worker that serves this folder as static assets.
// Workers Builds deploys it on every push to main. Only /api/* runs the Worker
// (server/worker.mjs); every other request is a plain asset, so the site costs
// nothing beyond the free tier. Ballots live in the D1 database "wcxc".
{
  "name": "wcxcdynasty",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "wcxc", "database_id": "74ba05b0-a269-451f-9d10-08812fccfffb" }
  ],
  "observability": { "enabled": true }
}
